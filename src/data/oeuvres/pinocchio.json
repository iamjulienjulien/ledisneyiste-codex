    "blocsEditoriaux": [
        {
            "id": "apres-blanche-neige-ne-pas-simplement-recommencer",
            "type": "repere",
            "eyebrow": "Deuxième long métrage",
            "titre": "Après Blanche-Neige, ne pas simplement recommencer",
            "question": "Pourquoi le deuxième long métrage est-il une nouvelle épreuve ?",
            "paragraphes": [
                {
                    "id": "apres-blanche-neige-un-encore-deja-en-chantier",
                    "texte": "Le développement de Pinocchio commence en 1937, alors que Blanche-Neige et les Sept Nains n’est pas encore achevé. Le studio prépare donc son deuxième long métrage avant de connaître toute la portée publique du premier : il ne répond pas à un succès par une recette déjà disponible, il avance pendant que cette forme nouvelle est encore en train de faire ses preuves.",
                    "sources": [
                        "us-afi-catalog-pinocchio",
                        "us-loc-pinocchio-essay"
                    ]
                },
                {
                    "id": "apres-blanche-neige-reprendre-le-recit",
